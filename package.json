{
  "name": "signal-trading",
  "version": "1.0.0",
  "private": true,
  "description": "Trading signal website hosted on Cloudflare Workers with a D1 database",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply signal-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply signal-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
